# ---- Supabase の接続先 ----
# Supabase の Project Settings → API（または Data API）で確認できる値。
# どちらもブラウザに渡ってよい「公開用」の値です（データは RLS とデータベースの関数で保護しています）。
# 以前の名前 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY でも動きます。
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ---- 予約のお知らせメール（任意。サーバーだけで使う秘密情報。NEXT_PUBLIC_ は付けない）----
# 未設定ならメールは送らない（予約は受け付ける）。手順は docs/setup.md の 7.5。
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# このアプリは Supabase の秘密鍵（service_role / secret key）を使いません。
# 秘密鍵は Vercel にも、このファイルにも設定しないでください。
