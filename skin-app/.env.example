# ---- Supabase の接続先（公開してよい値。ブラウザにも渡る）----
# URL と公開用キー（anon key または publishable key）。RLS が前提。
# 以前の名前 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY でも動く。
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ---- サーバーだけで使う値（絶対に NEXT_PUBLIC_ を付けない）----
# アプリの公開 URL（認証メールのリンク先）。Vercel では自動で決まるため通常は不要。
# 独自ドメインを使う場合や、手元で動かす場合に設定する。
# SITE_URL=http://localhost:3000

# スタッフの招待・管理者の操作の一部にだけ使う
SUPABASE_SERVICE_ROLE_KEY=

# Claude API（分析の説明文）。未設定なら AI を使わない仮の説明文で動く
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# 1日（日本時間）あたりの AI 利用回数の上限（既定：一般ユーザー 10回、スタッフ・管理者 100回）
# AI_DAILY_LIMIT_USER=10
# AI_DAILY_LIMIT_STAFF=100
