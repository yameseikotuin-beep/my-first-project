# ---- 端末にも渡る値（公開してよいもの）----
# Supabase の URL と公開用キー（RLS が前提）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- サーバーだけで使う値（絶対に NEXT_PUBLIC_ を付けない）----
# アプリの公開 URL（認証メールのリンク先）。Vercel では自動で決まるため通常は不要。
# 独自ドメインを使う場合や、手元で動かす場合に設定する。
# SITE_URL=http://localhost:3000

# スタッフの招待・管理者の操作の一部にだけ使う
SUPABASE_SERVICE_ROLE_KEY=

# 第3段階で使用（未設定ならモックで動く）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
