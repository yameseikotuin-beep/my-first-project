# 公開時に設定する値（すべて任意）。Vercel では「Settings → Environment Variables」に登録する。
# 未設定の項目は src/config/lp.config.ts の値が使われる。どちらも空なら「未設定」として扱う。
# NEXT_PUBLIC_ で始まる値はビルド時にページへ埋め込まれるため、変更したら再ビルド（再デプロイ）が必要。

# 既存の予約ページの URL（https:// で始まるもの）
NEXT_PUBLIC_RESERVATION_URL=

# GA4 の測定ID（例：G-XXXXXXXXXX）
NEXT_PUBLIC_GA4_ID=

# Meta Pixel ID（数字のみ）
NEXT_PUBLIC_META_PIXEL_ID=
